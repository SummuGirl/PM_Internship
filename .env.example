# Valkyrie Network - Environment Variables Template
# Copy this file to .env.local for local testing:
# cp .env.example .env.local

# Resend API Key (starts with re_...)
# Obtain from https://resend.com/api-keys
RESEND_API_KEY=

# Candidate Personal Email (where help requests will be sent)
# For free Resend accounts without a verified custom domain,
# this MUST be the email address you used to register on Resend.
CANDIDATE_EMAIL=
